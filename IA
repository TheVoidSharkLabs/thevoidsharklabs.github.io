function Show-SharkScreen {
    param($frame, $pct, $msg)
    Clear-Host
    Write-Host ""
    Write-Host "  +==================================================+" -ForegroundColor Cyan
    Write-Host "  |           SharkIA - Setup+                       |" -ForegroundColor Cyan
    Write-Host "  +==================================================+" -ForegroundColor Cyan
    Write-Host ""
    Write-Host "" 
    # Tubarao ASCII
    Write-Host "                                              " -ForegroundColor Cyan
    Write-Host "         ___                                  " -ForegroundColor Cyan
    Write-Host "        /   \___/|    $([char]126)$([char]126)$([char]126)              " -ForegroundColor Cyan

    # Posicao do tubarao baseada no frame
    $pos = "  " * ($frame % 10)
    $shark1 = $pos + "   ____"
    $shark2 = $pos + "  /. . \" + "__/"
    $shark3 = $pos + " |  __  " + "    ~~~"
    $shark4 = $pos + "  \____/" + "~~~~"

    Write-Host ""
    Write-Host ("  " + " " * (($frame * 3) % 35) + "   /\_/\  ") -ForegroundColor Cyan
    Write-Host ("  " + "~" * 5 + " " * (($frame * 3) % 20) + ">( " + [char]0x25CF + " )" + "~" * 10 + ">=>" + "~" * 8) -ForegroundColor Cyan
    Write-Host ("  " + " " * (($frame * 3) % 35) + "   \___/  ") -ForegroundColor Cyan
    Write-Host ""
    Write-Host ("  " + "~" * 50) -ForegroundColor DarkCyan
    Write-Host ""

    # Barra de progresso
    $filled = [math]::Floor($pct / 3)
    $empty  = 33 - $filled
    $bar    = ([char]9608 * $filled) + ([char]9617 * $empty)
    Write-Host "  [$bar] $pct%" -ForegroundColor $(if ($pct -lt 50) {"Yellow"} elseif ($pct -lt 90) {"Cyan"} else {"Green"})
    Write-Host ""
    Write-Host "  $msg" -ForegroundColor White
    Write-Host ""
}

