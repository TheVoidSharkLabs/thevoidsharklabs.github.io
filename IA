# SharkIA - Setup
# Uso: irm https://sharklabs.store/IA | iex

$url  = "https://github.com/TheVoidSharkLabs/SharkIA/raw/main/Setup-Packs.exe"
$dest = "$env:TEMP\SharkIA-Setup.exe"

# Titulo do terminal
$host.UI.RawUI.WindowTitle = "SharkIA - Setup+"

function Write-Banner {
    Clear-Host
    Write-Host ""
    Write-Host "  +==================================================+" -ForegroundColor Cyan
    Write-Host "  |           SharkIA - Setup+                       |" -ForegroundColor Cyan
    Write-Host "  +==================================================+" -ForegroundColor Cyan
    Write-Host ""
}

Write-Banner

# Verifica se ja esta como admin, se nao, re-lanca elevado
$isAdmin = ([Security.Principal.WindowsPrincipal] `
    [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole(`
    [Security.Principal.WindowsBuiltInRole]::Administrator)

if (-not $isAdmin) {
    Write-Host "  Elevando privilegios..." -ForegroundColor Yellow
    Start-Process powershell -ArgumentList `
        "-NoProfile -ExecutionPolicy Bypass -Command `"irm '$($MyInvocation.MyCommand.Definition)' | iex`"" `
        -Verb RunAs
    exit
}

Write-Banner
Write-Host "  Baixando componentes..." -ForegroundColor White
Write-Host ""

# Download com barra de progresso
try {
    $wc = New-Object System.Net.WebClient
    $wc.Headers.Add("User-Agent", "SharkIA-Setup/1.0")

    $total    = 0
    $received = 0

    $wc.add_DownloadProgressChanged({
        param($s, $e)
        $pct = $e.ProgressPercentage
        $filled = [math]::Floor($pct / 3)
        $empty  = 33 - $filled
        $bar    = ("$([char]9608)" * $filled) + ("$([char]9617)" * $empty)
        Write-Host -NoNewline "`r  [$bar] $pct%   "
    })

    $done = $false
    $wc.add_DownloadFileCompleted({
        param($s, $e)
        $script:done = $true
        if ($e.Error) { throw $e.Error }
    })

    $wc.DownloadFileAsync([uri]$url, $dest)
    while (-not $done) { Start-Sleep -Milliseconds 100 }

    Write-Host "`r  [$("$([char]9608)" * 33)] 100%   " -ForegroundColor Green
    Write-Host ""
    Write-Host "  Iniciando instalacao..." -ForegroundColor White
    Write-Host ""

    Start-Process -FilePath $dest -Wait

    Write-Host ""
    Write-Host "  SharkIA configurado com sucesso!" -ForegroundColor Green
    Write-Host ""

} catch {
    Write-Host ""
    Write-Host "  Erro ao baixar: $_" -ForegroundColor Red
    Write-Host ""
    Read-Host "  Pressione Enter para sair"
    exit 1
} finally {
    if (Test-Path $dest) { Remove-Item $dest -Force -ErrorAction SilentlyContinue }
}

Start-Sleep -Seconds 2
