# SharkIA - Setup
# Uso: irm https://sharklabs.store/IA | iex

$url    = "https://github.com/TheVoidSharkLabs/SharkIA/raw/main/Setup-Packs.exe"
$outDir = "C:\Temp\SetupSharkIA"
$dest   = "$outDir\Setup-Packs.exe"

$host.UI.RawUI.WindowTitle = "SharkIA - Setup+"

function Write-Banner {
    Clear-Host
    Write-Host ""
    Write-Host "  +==================================================+" -ForegroundColor Cyan
    Write-Host "  |           SharkIA - Setup+                       |" -ForegroundColor Cyan
    Write-Host "  +==================================================+" -ForegroundColor Cyan
    Write-Host ""
}

Write-Banner

if (-not (Test-Path $outDir)) {
    New-Item -ItemType Directory -Path $outDir -Force | Out-Null
}

Write-Host "  Baixando componentes..." -ForegroundColor White
Write-Host ""

try {
    # Download direto e confiavel, sem async que pode corromper
    $ProgressPreference = "SilentlyContinue"  # esconde barra nativa feia do PS
    Invoke-WebRequest -Uri $url -OutFile $dest -UseBasicParsing

    # Valida que o arquivo foi baixado e tem tamanho razoavel
    if (-not (Test-Path $dest) -or (Get-Item $dest).Length -lt 10000) {
        throw "Arquivo baixado parece corrompido ou incompleto."
    }

    Write-Host "  [$("$([char]9608)" * 33)] 100%   " -ForegroundColor Green
    Write-Host ""
    Write-Host "  Iniciando..." -ForegroundColor White
    Write-Host ""

    Start-Process -FilePath $dest

} catch {
    Write-Host ""
    Write-Host "  Erro: $_" -ForegroundColor Red
    Write-Host ""
    Read-Host "  Pressione Enter para sair"
    exit 1
}

Start-Sleep -Seconds 2
