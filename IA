function Show-Shark {
    param($frame, $pct)
    Clear-Host
    Write-Host ""
    Write-Host "  +==================================================+" -ForegroundColor Cyan
    Write-Host "  |           SharkIA - Setup+                       |" -ForegroundColor Cyan
    Write-Host "  +==================================================+" -ForegroundColor Cyan
    Write-Host ""
    Write-Host ""
    Write-Host "  $($shark[$frame % $shark.Count])" -ForegroundColor Cyan
    Write-Host "  $($waves[$frame % 3])" -ForegroundColor DarkCyan
    Write-Host ""

    $filled = [math]::Floor($pct / 3)
    $empty  = 33 - $filled
    $bar    = ([char]9608 * $filled) + ([char]9617 * $empty)
    $cor    = if ($pct -lt 50) {"Yellow"} elseif ($pct -lt 90) {"Cyan"} else {"Green"}
    Write-Host "  [$bar] $pct%" -ForegroundColor $cor
    Write-Host ""
    Write-Host "  Baixando componentes..." -ForegroundColor DarkGray
    Write-Host ""
}

if (-not (Test-Path $outDir)) {
    New-Item -ItemType Directory -Path $outDir -Force | Out-Null
}

try {
    $ProgressPreference = "SilentlyContinue"

    # Inicia download async com WebClient para ter progresso real
    $wc   = New-Object System.Net.WebClient
    $wc.Headers.Add("User-Agent", "SharkIA-Setup/1.0")

    $pct    = 0
    $done   = $false
    $erro   = $null
    $frame  = 0

    $wc.add_DownloadProgressChanged({
        param($s, $e)
        $script:pct = $e.ProgressPercentage
    })
    $wc.add_DownloadFileCompleted({
        param($s, $e)
        $script:done = $true
        if ($e.Error) { $script:erro = $e.Error.Message }
    })

    $wc.DownloadFileAsync([uri]$url, $dest)

    # Anima o tubarao enquanto baixa
    while (-not $done) {
        Show-Shark -frame $frame -pct $pct
        $frame++
        Start-Sleep -Milliseconds 120
    }

    if ($erro) { throw $erro }

    # Valida arquivo
    if (-not (Test-Path $dest) -or (Get-Item $dest).Length -lt 10000) {
        throw "Arquivo corrompido ou incompleto."
    }

    # Animacao final 100%
    Show-Shark -frame $frame -pct 100
    Start-Sleep -Milliseconds 500

    Clear-Host
    Write-Host ""
    Write-Host "  +==================================================+" -ForegroundColor Cyan
    Write-Host "  |           SharkIA - Setup+                       |" -ForegroundColor Cyan
    Write-Host "  +==================================================+" -ForegroundColor Cyan
    Write-Host ""
    Write-Host "  >==}))°>   Prontos para mergulhar!" -ForegroundColor Cyan
    Write-Host ""
    Write-Host "  Iniciando SharkIA..." -ForegroundColor Green
    Write-Host ""

    Start-Sleep -Seconds 1
    Start-Process -FilePath $dest

} catch {
    Write-Host ""
    Write-Host "  Erro: $_" -ForegroundColor Red
    Write-Host ""
    Read-Host "  Pressione Enter para sair"
    exit 1
}

Start-Sleep -Seconds 2
