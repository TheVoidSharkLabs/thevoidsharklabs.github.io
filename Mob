    $bootLines = @(
        @("  [*] Inicializando kernel seguro...", "Green"),
        @("  [*] Carregando modulos criptograficos...", "DarkGreen"),
        @("  [*] Estabelecendo tunel TLS 1.2...", "Green"),
        @("  [*] Verificando integridade do repo...", "DarkGreen"),
        @("  [*] Bypass de cache local ativado...", "Green"),
        @("  [*] Mapeando assets do release...", "DarkGreen"),
        @("  [+] Sistema pronto.", "Cyan")
    )
    foreach ($line in $bootLines) {
        Write-HackerText -Text $line[0] -Color $line[1] -DelayMs 12
        Start-Sleep -Milliseconds (Get-Random -Minimum 80 -Maximum 250)
    }
}

