function Show-WipeLines {
    param([int]$Count = 5)
    for ($i = 0; $i -lt $Count; $i++) {
        $line = ""
        for ($j = 0; $j -lt ([Console]::WindowWidth - 4); $j++) {
            $line += [char](Get-Random -Minimum 0x2580 -Maximum 0x2590)
        }
        Write-Host "  $line" -ForegroundColor DarkGreen
        Start-Sleep -Milliseconds 30
    }
    for ($i = 0; $i -lt $Count; $i++) { Write-Host "`e[1A`e[2K" -NoNewline }
}

# ============================================================
#  FUNCOES ORIGINAIS DO INSTALADOR
# ============================================================

function Stop-LockingProcess {
    param([string]$FilePath)
    $fileName = [System.IO.Path]::GetFileNameWithoutExtension($FilePath)
    $procs = Get-Process -Name $fileName -ErrorAction SilentlyContinue |
        Where-Object { try { $_.Path -eq $FilePath } catch { $false } }
    if ($procs) {
        foreach ($p in $procs) {
            Write-Host "  [!] Encerrando processo: $($p.Name) PID=$($p.Id)" -ForegroundColor Yellow
            try { Stop-Process -Id $p.Id -Force -ErrorAction Stop }
            catch { Write-Host "  [WARN] PID $($p.Id): $($_.Exception.Message)" -ForegroundColor DarkYellow }
        }
        Start-Sleep -Milliseconds 500
    }
}

function Remove-FileWithRetry {
    param(
        [string]$FilePath,
        [int]$MaxAttempts = 5,
        [int]$DelayMs = 700
    )
    if (-not (Test-Path $FilePath)) { return $true }
    Stop-LockingProcess -FilePath $FilePath
    for ($i = 1; $i -le $MaxAttempts; $i++) {
        try {
            Remove-Item $FilePath -Force -ErrorAction Stop
            return $true
        } catch {
            if ($i -eq $MaxAttempts) {
                Write-Host "  [X] FALHA ao remover '$FilePath' apos $MaxAttempts tentativas." -ForegroundColor Red
                Write-Host "      Motivo: $($_.Exception.Message)" -ForegroundColor Red
                return $false
            }
            Write-Host "  [~] Arquivo travado, retentando ($i/$MaxAttempts)..." -ForegroundColor DarkYellow
            Start-Sleep -Milliseconds $DelayMs
        }
    }
    return $false
}

# ============================================================
#  SEQUENCIA DE INICIALIZACAO
# ============================================================

Clear-Host
Show-Banner

Write-Host ""
Show-MatrixRain -DurationMs 1200 -Columns 50
Write-Host ""

Show-BootSequence
Write-Host ""

Show-HexDump -FakeData "PANDO_MOBILADOR_v2" -Lines 6
Write-Host ""

# ============================================================
#  1) CONSULTA API GITHUB
# ============================================================

Write-HackerText -Text "  [>>] Conectando ao repositorio remoto..." -Color Cyan -DelayMs 15
Write-Host "      TARGET: $repo" -ForegroundColor DarkGray
Write-Host ""

Show-HackerProgress -Label "  ESTABELECENDO CONEXAO" -DurationMs 900

try {
    $headers = @{ "User-Agent" = "PandoMobilador-Installer" }
    $release = Invoke-RestMethod -Uri $apiUrl -Headers $headers -UseBasicParsing -ErrorAction Stop
} catch {
    Show-GlitchLine -Text "[FATAL] Falha na conexao: $($_.Exception.Message)" -Color Red
    Read-Host "  Pressione Enter para sair"
    exit 1
}

Show-Scanline -Count 3
Write-GlitchLine -Text "[OK] Conexao estabelecida com sucesso!" -Color Green
Write-Host ""

# ============================================================
#  2) PROCURA ASSET .EXE
# ============================================================

Write-HackerText -Text "  [>>] Escaneando assets do release..." -Color Cyan -DelayMs 15

Show-HackerProgress -Label "  MAPEANDO ARQUIVOS" -DurationMs 700

$exeAsset = $release.assets | Where-Object { $_.name -like "*.exe" } | Select-Object -First 1

if (-not $exeAsset) {
    Show-GlitchLine -Text "[FATAL] Nenhum .exe encontrado no release '$($release.tag_name)'" -Color Red
    Read-Host "  Pressione Enter para sair"
    exit 1
}

$url = $exeAsset.browser_download_url
$fileName = $exeAsset.name
$outPath = Join-Path $tempDir $fileName

Write-Host ""
Write-Host "  +-----------------------------+" -ForegroundColor DarkGreen
Write-Host "  |  RELEASE: " -ForegroundColor DarkGreen -NoNewline
Write-Host "$($release.tag_name)".PadRight(18) -ForegroundColor Green -NoNewline
Write-Host "|" -ForegroundColor DarkGreen
Write-Host "  |  ARQUIVO: " -ForegroundColor DarkGreen -NoNewline
Write-Host "$fileName".PadRight(18) -ForegroundColor Green -NoNewline
Write-Host "|" -ForegroundColor DarkGreen
Write-Host "  +-----------------------------+" -ForegroundColor DarkGreen
Write-Host ""

# ============================================================
#  3) REMOVE VERSAO ANTIGA
# ============================================================

if (Test-Path $outPath) {
    Write-HackerText -Text "  [!!] Versao antiga detectada, eliminando..." -Color Yellow -DelayMs 12
    Show-HackerProgress -Label "  LIMPEZA DE RESIDUOS" -DurationMs 500
    if (Remove-FileWithRetry -FilePath $outPath) {
        Write-GlitchLine -Text "[OK] Residuo removido." -Color Green
    } else {
        Read-Host "  Pressione Enter para sair"
        exit 1
    }
    Write-Host ""
}

# Limpa .exe antigos
Get-ChildItem -Path $tempDir -Filter "*.exe" -File -ErrorAction SilentlyContinue | ForEach-Object {
    if ($_.Name -ne $fileName) {
        Remove-FileWithRetry -FilePath $_.FullName | Out-Null
    }
}

# ============================================================
#  4) DOWNLOAD
# ============================================================

Write-HackerText -Text "  [>>] Iniciando transferencia de dados..." -Color Cyan -DelayMs 15
Write-Host "      ORIGEM: $url" -ForegroundColor DarkGray
Write-Host ""

try {
    $ProgressPreference = "SilentlyContinue"
    Invoke-WebRequest -Uri $url -OutFile $outPath -UseBasicParsing -ErrorAction Stop
    $sizeMB = [math]::Round((Get-Item $outPath).Length / 1MB, 2)

    Write-Host ""
    Show-WipeLines -Count 4
    Write-GlitchLine -Text "[OK] Download concluido! ($sizeMB MB transferidos)" -Color Green
    Write-Host ""
} catch {
    Show-GlitchLine -Text "[FATAL] Falha no download: $($_.Exception.Message)" -Color Red
    Read-Host "  Pressione Enter para sair"
    exit 1
}

# Verificacoes de integridade
Write-HackerText -Text "  [>>] Verificando integridade do payload..." -Color Cyan -DelayMs 15

Show-HackerProgress -Label "  HASH & INTEGRIDADE" -DurationMs 800

if (-not (Test-Path $outPath)) {
    Show-GlitchLine -Text "[FATAL] Arquivo ausente apos download." -Color Red
    Read-Host "  Pressione Enter para sair"
    exit 1
}
if ((Get-Item $outPath).Length -eq 0) {
    Show-GlitchLine -Text "[FATAL] Payload vazio (0 bytes). Possivel corrupcao." -Color Red
    Remove-Item $outPath -Force -ErrorAction SilentlyContinue
    Read-Host "  Pressione Enter para sair"
    exit 1
}

$fileHash = (Get-FileHash -Path $outPath -Algorithm SHA256).Hash
Write-Host ""
Write-Host "  SHA256: " -ForegroundColor DarkGray -NoNewline
Write-Host $fileHash -ForegroundColor DarkCyan
Write-Host ""

Show-GlitchLine -Text "[OK] Integridade confirmada. Payload limpo." -Color Green
Write-Host ""

# ============================================================
#  5) EXECUCAO
# ============================================================

Write-Host "  ════════════════════════════════════════════════" -ForegroundColor DarkGreen
Write-HackerText -Text "  [>>] DESPACHANDO PAYLOAD..." -Color Cyan -DelayMs 25
Write-Host "  ════════════════════════════════════════════════" -ForegroundColor DarkGreen
Write-Host ""

Show-Countdown
Write-Host ""

try {
    Start-Process -FilePath $outPath -WorkingDirectory $tempDir -ErrorAction Stop

    Show-MatrixRain -DurationMs 800 -Columns 50

    Write-Host ""
    Write-Host "  ╔══════════════════════════════════════════╗" -ForegroundColor Green
    Write-Host "  ║                                          ║" -ForegroundColor Green
    Write-HackerText -Text "  ║   PANDO MOBILADOR INICIADO COM SUCESSO   ║" -Color Green -DelayMs 20
    Write-Host "  ║                                          ║" -ForegroundColor Green
    Write-Host "  ╚══════════════════════════════════════════╝" -ForegroundColor Green
    Write-Host ""

} catch {
    Show-GlitchLine -Text "[FATAL] Falha ao executar: $($_.Exception.Message)" -Color Red
    Read-Host "  Pressione Enter para sair"
    exit 1
}

Write-Host ""
Write-HackerText -Text "  [OK] Sessao encerrada. Ate a proxima." -Color DarkGreen -DelayMs 20
Write-Host ""
