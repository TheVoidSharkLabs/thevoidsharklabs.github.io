$ErrorActionPreference = "Stop"
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$repo = "TheVoidSharkLabs/PANDO-MOBILADOR"
$apiUrl = "https://api.github.com/repos/$repo/releases/latest"

$tempDir = Join-Path $env:TEMP "PandoMobilador"
if (-not (Test-Path $tempDir)) {
    New-Item -ItemType Directory -Path $tempDir -Force | Out-Null
}

# ============================================================
#  FUNCOES DE ANIMACAO HACKER
# ============================================================

function Write-HackerText {
    param(
        [string]$Text,
        [ConsoleColor]$Color = "Green",
        [int]$DelayMs = 18,
        [bool]$NoNewline = $false
    )
    foreach ($char in $Text.ToCharArray()) {
        Write-Host $char -ForegroundColor $Color -NoNewline
        Start-Sleep -Milliseconds $DelayMs
    }
    if (-not $NoNewline) { Write-Host "" }
}

function Write-GlitchLine {
    param([string]$Text, [ConsoleColor]$Color = "Green")
    $glitchChars = @('#', '@', '%', '&', '*', '?', '!', '$', '~', '^', '/', '\', '|', '{', '}', '[', ']')
    $iterations = 3
    for ($g = 0; $g -lt $iterations; $g++) {
        $glitched = ""
        foreach ($char in $Text.ToCharArray()) {
            if ((Get-Random -Minimum 0 -Maximum 100) -lt 30) {
                $glitched += $glitchChars[(Get-Random -Minimum 0 -Maximum $glitchChars.Length)]
            } else {
                $glitched += $char
            }
        }
        Write-Host "`r  $glitched" -ForegroundColor (Get-Random @("Green","DarkGreen","Cyan","DarkCyan")) -NoNewline
        Start-Sleep -Milliseconds 50
    }
    Write-Host "`r  $Text" -ForegroundColor $Color
}

function Show-MatrixRain {
    param([int]$DurationMs = 1500, [int]$Columns = 40)
    $width = [Math]::Min($Columns, ([Console]::WindowWidth - 4))
    $chars = "01アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン"
    $positions = @()
    for ($i = 0; $i -lt $width; $i++) {
        $positions += Get-Random -Minimum 0 -Maximum 20
    }
    $startTime = Get-Date
    while (((Get-Date) - $startTime).TotalMilliseconds -lt $DurationMs) {
        $line = ""
        for ($i = 0; $i -lt $width; $i++) {
            if ((Get-Random -Minimum 0 -Maximum 100) -lt 70) {
                $line += $chars[(Get-Random -Minimum 0 -Maximum $chars.Length)]
            } else {
                $line += " "
            }
        }
        Write-Host "  $line" -ForegroundColor DarkGreen
        Start-Sleep -Milliseconds 45
    }
}

function Show-HackerProgress {
    param(
        [string]$Label,
        [int]$DurationMs = 1200
    )
    $barLen = 30
    $blocks = [char]0x2588
    $startTime = Get-Date
    while ($true) {
        $elapsed = ((Get-Date) - $startTime).TotalMilliseconds
        $pct = [Math]::Min($elapsed / $DurationMs, 1.0)
        $filled = [Math]::Floor($pct * $barLen)
        $empty = $barLen - $filled

        $filledStr = [string]$blocks * $filled
        $emptyStr = " " * $empty
        $pctStr = "{0,3}%" -f [Math]::Floor($pct * 100)

        Write-Host "`r  $label [" -ForegroundColor DarkGray -NoNewline
        Write-Host $filledStr -ForegroundColor Green -NoNewline
        Write-Host $emptyStr -NoNewline
        Write-Host "] $pctStr" -ForegroundColor DarkGray -NoNewline

        if ($pct -ge 1.0) { break }
        Start-Sleep -Milliseconds 30
    }
    Write-Host ""
}

function Show-Scanline {
    param([int]$Count = 8)
    for ($i = 0; $i -lt $Count; $i++) {
        $line = ""
        for ($j = 0; $j -lt ([Console]::WindowWidth - 2); $j++) {
            if ((Get-Random -Minimum 0 -Maximum 100) -lt 15) {
                $line += [char](Get-Random -Minimum 0x2591 -Maximum 0x2593)
            } else {
                $line += " "
            }
        }
        Write-Host "  $line" -ForegroundColor DarkGreen
        Start-Sleep -Milliseconds 30
    }
}

function Show-HexDump {
    param([string]$FakeData = "PANDO_MOBILADOR", [int]$Lines = 5)
    $bytes = [System.Text.Encoding]::UTF8.GetBytes($FakeData)
    for ($i = 0; $i -lt $Lines; $i++) {
        $addr = "{0:X8}" -f ($i * 16)
        $hex = ""
        $ascii = ""
        for ($j = 0; $j -lt 16; $j++) {
            $b = Get-Random -Minimum 0 -Maximum 256
            $hex += "{0:X2} " -f $b
            if ($j -eq 7) { $hex += " " }
            if ($b -ge 32 -and $b -le 126) {
                $ascii += [char]$b
            } else {
                $ascii += "."
            }
        }
        Write-Host "  0x$addr  " -ForegroundColor DarkGray -NoNewline
        Write-Host $hex -ForegroundColor Green -NoNewline
        Write-Host " |$ascii|" -ForegroundColor DarkCyan
        Start-Sleep -Milliseconds 40
    }
}

